<Window x:Class="TeamScreen.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Screen preview" Width="640" Height="440" MinWidth="380" MinHeight="300"
        WindowStartupLocation="Manual" AllowDrop="True">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <Border CornerRadius="8" Background="Black" ClipToBounds="True">
            <Grid>
                <Image x:Name="Frame" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="OffText" Text="Team screen is off" Foreground="#8A8F98" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Border x:Name="DropHint" Background="#CC0078D4" Visibility="Collapsed" CornerRadius="8">
                    <TextBlock Text="Drop to show it on the team screen" Foreground="White" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                        CornerRadius="4" Padding="8,3" Background="#E81123">
                    <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12" FontWeight="SemiBold" Text="LIVE" />
                </Border>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DashboardBtn" Content="Dashboard" Margin="0,0,6,0" Click="Dashboard_Click" />
                <Button x:Name="AreaBtn" Content="Mirror area" Margin="0,0,6,0" Click="Area_Click" />
                <ToggleButton x:Name="FreezeBtn" Content="Freeze" Margin="0,0,6,0" Click="Freeze_Click" />
                <ToggleButton x:Name="BlankBtn" Content="Blank" Margin="0,0,6,0" Click="Blank_Click" />
                <Button x:Name="PowerBtn" Content="Turn off" Click="Power_Click" />
            </StackPanel>
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
