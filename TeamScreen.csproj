<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TeamScreen</AssemblyName>
    <RootNamespace>TeamScreen</RootNamespace>
    <Product>Team Screen</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Company>JakeTheRabbit</Company>
    <Description>Show a dashboard, pictures, pages or a live piece of your screen on a second monitor.</Description>
    <!-- WPF0001: Fluent ThemeMode still experimental in .NET 10. WFO0003: WPF reads DPI awareness from app.manifest, not the WinForms API. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
