<Window x:Class="TeamScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team Screen settings" Width="900" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="232,*" RowDefinitions="*,Auto">
        <DockPanel Margin="12,12,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,16">
                <Image x:Name="AppIcon" Width="28" Height="28" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Team Screen" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusLine" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="Nav_SelectionChanged" />
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12,12,24,12">
            <ContentControl x:Name="Page" />
        </ScrollViewer>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="16,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Width="96" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                    <Button Content="Apply" Width="96" Margin="0,0,8,0" Click="Apply_Click" />
                    <Button Content="Save" Width="96" Click="Save_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
                <TextBlock x:Name="Footer" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
