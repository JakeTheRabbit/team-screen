<Window x:Class="TeamScreen.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Team Screen" ThemeMode="None"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Black" Cursor="None">
    <!-- Layers, bottom to top. WebView2 is a native child window, so it must be collapsed whenever anything sits above it. -->
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="Black" />
        <Image x:Name="Live" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="Still" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
        <Grid x:Name="BlankLayer" Background="Black" Visibility="Collapsed">
            <TextBlock x:Name="BlankText" Foreground="#8A8F98" FontSize="72" FontWeight="Light"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
